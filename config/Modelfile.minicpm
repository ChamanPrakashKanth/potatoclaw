FROM C:\Users\user\Downloads\Model\MiniCPM5-2B-Q4_K_M.gguf

# Low Context: 2048 tokens for ultra-low KV-cache RAM/VRAM footprint
PARAMETER num_ctx 2048

# GPU Offloading: Keep this conservative for a 4GB GTX 1650; override if needed.
PARAMETER num_gpu 18

# CPU Offloading: Offload remaining computation across 6 CPU cores
PARAMETER num_thread 6

# Generation parameters
PARAMETER temperature 0.7
PARAMETER top_p 0.95
