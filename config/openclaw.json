{
  "$schema": "https://docs.openclaw.ai/schema.json",
  "potatoMode": true,
  "browser": {
    "enabled": true,
    "defaultProfile": "chrome",
    "profiles": {
      "chrome": {
        "cdpUrl": "http://127.0.0.1:9222",
        "attachOnly": true
      }
    }
  },
  "models": {
    "providers": {
      "minicpm": {
        "baseUrl": "http://127.0.0.1:11435/v1",
        "apiKey": "local-key",
        "api": "openai-completions",
        "models": [
          {
            "id": "minicpm5-2b:latest",
            "name": "MiniCPM5-2B (Shared Low-VRAM)",
            "input": ["text"],
            "contextTokens": 2048,
            "params": {
              "temperature": 0.7
            }
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "potatoMode": true,
      "model": {
        "primary": "minicpm/minicpm5-2b:latest"
      },
      "models": {
        "minicpm/minicpm5-2b:latest": {}
      },
      "modelPolicy": {
        "allow": [
          "minicpm/minicpm5-2b:latest"
        ]
      },
      "experimental": {
        "localModelLean": true,
        "potatoMode": true
      }
    }
  }
}
